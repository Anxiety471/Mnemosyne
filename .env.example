# Copy to .env and replace both secrets with different random values.
# Do not commit .env; keep it private (chmod 600 .env).
DRAWER_ADMIN_PASSWORD=replace-with-a-long-random-password
DRAWER_TOKEN=replace-with-a-different-long-random-token
# Set to true when accessed via HTTPS. Keep false only on private HTTP/Tailscale.
DRAWER_COOKIE_SECURE=false

# Optional: comma-separated web origins allowed to call the API, for example
# DRAWER_CORS_ORIGINS=https://drawer.example.com (use * for the old permissive default).
# Without this variable a server with no admin password answers no CORS headers at all,
# so browser pages on another origin cannot call the API. Ignored when
# DRAWER_ADMIN_PASSWORD is set.

# Compose: how Drawer is exposed. The default keeps the port on loopback only.
# DRAWER_PUBLISH=127.0.0.1:8787
# Compose resource limits. Raise these if you serve large uploads or many agents.
# DRAWER_MEM_LIMIT=512M
# DRAWER_CPU_LIMIT=1.0
